# ============================================================
# Ad Analytics Streaming Pipeline - Environment Configuration
# ============================================================

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_EXTERNAL_PORT=9093
KAFKA_VIEWS_TOPIC=views-topic
KAFKA_CLICKS_TOPIC=clicks-topic
KAFKA_METRICS_TOPIC=metrics-topic
KAFKA_DLQ_TOPIC=dead-letter-topic
KAFKA_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1

# Flink Configuration
FLINK_JOBMANAGER_RPC_ADDRESS=jobmanager
FLINK_JOBMANAGER_RPC_PORT=6123
FLINK_PARALLELISM=2
FLINK_CHECKPOINT_INTERVAL=60000
FLINK_CHECKPOINT_DIR=file:///opt/flink/checkpoints
FLINK_WATERMARK_DELAY_SECONDS=10
FLINK_JOIN_WINDOW_SECONDS=30

# Producer Configuration
PRODUCER_MODE=csv
PRODUCER_SPEED_MULTIPLIER=10
PRODUCER_DELAY_MS=100
PRODUCER_BATCH_SIZE=16384
PRODUCER_LINGER_MS=5

# Consumer Configuration
CONSUMER_PRETTY_PRINT=true
CONSUMER_OUTPUT_FILE=/tmp/metrics-output.json

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
KAFKA_UI_PORT=8080
FLINK_DASHBOARD_PORT=8081
